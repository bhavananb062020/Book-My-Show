pipeline {
    agent any

    //Make sure configure jdk17 and nodejs18 available in this build
    tools {
        jdk 'jdk17'
        nodejs 'node18'
    }

    //These are variables used throughout the pipeline.
    environment {
        SCANNER_HOME = tool 'sonar-scanner'

        // Docker Hub image
        // DOCKER_IMAGE = 'bhavananb062020/bms:latest'

        // ECR image
        ECR_REPOSITORY = '571996362633.dkr.ecr.ap-south-1.amazonaws.com/bms'
        DOCKER_IMAGE = "${ECR_REPOSITORY}:latest"

        // EKS details
        EKS_CLUSTER_NAME = 'kastro-eks'
        AWS_REGION = 'ap-south-1'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/bhavananb062020/Book-My-Show.git'

                sh '''
                    echo "Files in workspace:"
                    ls -la

                    echo "Application files:"
                    ls -la bookmyshow-app

                    echo "Kubernetes files:"
                    ls -la deployment.yml service.yml
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectName=BookMyShow  \
                        -Dsonar.projectKey=BookMyShow
                    '''
                }
            }
        }

        //SonarQube webhook is used(to post the results to jenkins)
        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate(
                abortPipeline: true,
                credentialsId: 'sonar-qube'
            )
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    cd bookmyshow-app

                    echo "Checking package.json..."

                    if [ -f package.json ]; then

                        echo "Installing Node.js dependencies..."

                        rm -rf node_modules
                        npm install

                    else

                        echo "ERROR: package.json not found!"
                        exit 1

                    fi
                '''
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "Running Trivy filesystem scan..."

                    trivy fs . > trivyfs.txt

                    echo "Trivy scan completed."
                '''
            }
        }

        // Docker build and push to Docker Hub
        // stage('Docker Build & Push') {
        //     steps {
        //         script {
        //             withDockerRegistry(
        //                 credentialsId: 'Dockerhub',
        //                 toolName: 'docker'
        //             ) {
        //                 sh '''
        //                     echo "================================="
        //                     echo "Building Docker Image"
        //                     echo "================================="

        //                     docker build --no-cache \
        //                         -t $DOCKER_IMAGE \
        //                         -f bookmyshow-app/Dockerfile \
        //                         bookmyshow-app

        //                     echo "================================="
        //                     echo "Docker Image"
        //                     echo "================================="

        //                     docker images | grep bms

        //                     echo "================================="
        //                     echo "Pushing Image to Docker Hub"
        //                     echo "================================="

        //                     docker push $DOCKER_IMAGE

        //                     echo "Docker image pushed successfully."
        //                 '''
        //             }
        //         }
        //     }
        // }

        // Docker build and push to ECR
        stage('Docker Build & Push to ECR') {
            steps {
                sh '''
            echo "================================="
            echo "AWS Identity"
            echo "================================="

            aws sts get-caller-identity

            echo "================================="
            echo "Logging in to Amazon ECR"
            echo "================================="

            aws ecr get-login-password --region $AWS_REGION | \
            docker login \
            --username AWS \
            --password-stdin $ECR_REPOSITORY

            echo "================================="
            echo "Building Docker Image"
            echo "================================="

            docker build --no-cache \
                -t $DOCKER_IMAGE \
                -f bookmyshow-app/Dockerfile \
                bookmyshow-app

            echo "================================="
            echo "Docker Image"
            echo "================================="

            docker images | grep bms

            echo "================================="
            echo "Pushing Image to Amazon ECR"
            echo "================================="

            docker push $DOCKER_IMAGE

            echo "================================="
            echo "ECR Push Successful"
            echo "================================="
        '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                script {
                    sh '''
                        echo "================================="
                        echo "Checking AWS Credentials"
                        echo "================================="

                        aws sts get-caller-identity

                        echo "================================="
                        echo "Configuring EKS"
                        echo "================================="

                        aws eks update-kubeconfig \
                            --name $EKS_CLUSTER_NAME \
                            --region $AWS_REGION

                        echo "================================="
                        echo "Checking EKS Nodes"
                        echo "================================="

                        kubectl get nodes

                        echo "================================="
                        echo "Deploying Application"
                        echo "================================="

                        kubectl apply -f deployment.yml

                        kubectl apply -f service.yml

                        echo "================================="
                        echo "Checking Deployment"
                        echo "================================="

                        kubectl get deployments

                        echo "================================="
                        echo "Checking Pods"
                        echo "================================="

                        kubectl get pods

                        echo "================================="
                        echo "Checking Services"
                        echo "================================="

                        kubectl get svc
                    '''
                }
            }
        }
        
// Verify the application deployment and check the status of pods and services
        stage('Verify Application') {
            steps {
                sh '''
                    echo "================================="
                    echo "Waiting for Pods"
                    echo "================================="

                    sleep 20

                    kubectl get pods -o wide

                    echo "================================="
                    echo "Deployment Status"
                    echo "================================="

                    kubectl rollout status deployment/bms-app --timeout=120s

                    echo "================================="
                    echo "Final Kubernetes Status"
                    echo "================================="

                    kubectl get all
                '''
            }
        }
    }

    post {
        always {
            emailext(
                attachLog: true,

                subject: "${currentBuild.result}: ${env.JOB_NAME}",

                body: """
                    <h3>BookMyShow Pipeline Result</h3>

                    <b>Project:</b> ${env.JOB_NAME}<br/>
                    <b>Build Number:</b> ${env.BUILD_NUMBER}<br/>
                    <b>Status:</b> ${currentBuild.result}<br/>
                    <b>Build URL:</b> ${env.BUILD_URL}<br/>
                    <b>EKS Cluster:</b> ${EKS_CLUSTER_NAME}<br/>
                """,

                to: 'bhavananb2003@gmail.com',

                attachmentsPattern: 'trivyfs.txt'
            )
        }
    }
}
